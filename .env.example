# PromptWizard: переменные окружения (скопируйте в .env и заполните)
# LLM-доработка (refine) — опциональна; автономный режим работает без ключа.

# API-ключ OpenAI-совместимого или Anthropic провайдера
PROMPTWIZARD_LLM_API_KEY=

# Провайдер: openai | anthropic (по умолчанию openai)
PROMPTWIZARD_LLM_PROVIDER=

# Базовый URL для OpenAI-совместимых прокси/локальных серверов
# (для anthropic используется https://api.anthropic.com)
PROMPTWIZARD_LLM_BASE_URL=

# Используемая модель (например: gpt-4o-mini, claude-sonnet-4-5)
PROMPTWIZARD_LLM_MODEL=
