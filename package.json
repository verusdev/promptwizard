{
  "name": "promptwizard",
  "version": "0.1.0",
  "description": "CLI-ассистент для сборки качественных структурированных промтов: изображения, код, тексты, видео, музыка",
  "type": "module",
  "bin": {
    "promptwizard": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && tsc && node scripts/copy-assets.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "keywords": [
    "prompt",
    "prompt-engineering",
    "cli",
    "midjourney",
    "stable-diffusion",
    "dalle",
    "llm"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "ora": "^8.1.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  }
}
